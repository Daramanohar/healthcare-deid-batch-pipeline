{
  "root_dir": ".",
  "input": {
    "dicom_dir": "DICOMs",
    "pdf_dir": "PDFs"
  },
  "output": {
    "base_dir": "outputs/task1_pipeline"
  },
  "database": {
    "path": "outputs/task1_pipeline/metadata/pipeline.db"
  },
  "dicom": {
    "remove_private_tags": true,
    "clear_dates": true,
    "clear_times": true,
    "uid_prefix": "2.25.",
    "pixel_redaction_enabled": true,
    "pixel_redaction_zones": [
      {
        "name": "lower_burned_in_annotation_band",
        "x0": 0.0,
        "y0": 0.78,
        "x1": 1.0,
        "y1": 1.0
      }
    ],
    "safe_metadata_keywords": [
      "Modality",
      "Manufacturer",
      "ManufacturerModelName",
      "BodyPartExamined",
      "Rows",
      "Columns",
      "PatientSex",
      "StudyDescription",
      "SeriesDescription"
    ]
  },
  "pdf": {
    "sensitive_fields": [
      "Patient ID",
      "Patient Name",
      "MRN",
      "Medical Record Number",
      "Date of Birth",
      "DOB",
      "Accession Number"
    ],
    "regex_patterns": [],
    "redaction_padding": 1.5
  },
  "logging": {
    "level": "INFO"
  }
}
